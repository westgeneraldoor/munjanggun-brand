{
  "$schema": "https://tokens.studio/schemas/tokens.json",
  "meta": {
    "brand": "MUNJANGGUN",
    "version": "v4.0",
    "concept": "동네 온기 (Neighborhood Warmth)",
    "source": "DESIGN.md front matter",
    "updated": "2026-07-03",
    "authority": [
      "DESIGN.md front matter",
      "tokens/brand.tokens.json",
      "tokens/brand.css",
      "BRAND_GUIDELINE.html and project implementations"
    ],
    "nameMapping": {
      "description": "DESIGN.md token names use kebab-case and `rounded`; JSON uses camelCase and `radius`; CSS variables use `--mg-*` kebab-case. Values must remain equivalent across formats.",
      "rounded": "radius",
      "button-primary": "buttonPrimary",
      "button-secondary": "buttonSecondary",
      "button-tertiary": "buttonTertiary",
      "badge": "badge",
      "card": "card",
      "form-field": "formField",
      "cta-banner": "ctaBanner",
      "error-message": "errorMessage"
    },
    "breakingChangeFrom": "v3.0",
    "migrationNote": "v3.0의 cocoa-oak/clay-terracotta/cashmere-cream/verified-navy 체계와 Noto Serif KR 서체를 전면 폐기했다. DESIGN.md 13장의 매핑표를 참고해 연계 프로젝트를 갱신한다.",
    "rule": "When tokens change, update DESIGN.md first, then regenerate this file, tokens/brand.css, BRAND_GUIDELINE.html, and CHANGELOG.md together."
  },
  "colors": {
    "ivory": { "value": "#FBF7F1", "type": "color", "description": "기본 배경. 본문 텍스트 대비 14.2:1." },
    "surface": { "value": "#FFFFFF", "type": "color", "description": "카드, 폼 배경." },
    "surfaceAlt": { "value": "#F3E9DC", "type": "color", "description": "보조 섹션, 호버 배경." },
    "border": { "value": "#EDE0D3", "type": "color", "description": "기본 테두리. 텍스트 용도 아님." },
    "borderStrong": { "value": "#D9C4A8", "type": "color", "description": "강조 테두리. 텍스트 용도 아님." },
    "text": { "value": "#2E241C", "type": "color", "description": "본문 텍스트." },
    "textSub": { "value": "#78685A", "type": "color", "description": "보조 설명, 캡션." },
    "clay": { "value": "#9C4E2C", "type": "color", "description": "주 버튼, 링크, CTA. White 텍스트 5.93:1 PASS." },
    "clayLight": { "value": "#BD6A44", "type": "color", "description": "배지·장식·큰 텍스트 전용. White 텍스트 3.96:1 Large만 PASS." },
    "clayHover": { "value": "#86401F", "type": "color", "description": "버튼 hover/active." },
    "sage": { "value": "#5C7A62", "type": "color", "description": "보조 버튼, 배지 배경. White 텍스트 4.76:1 PASS." },
    "sageText": { "value": "#3F5643", "type": "color", "description": "세이지 계열을 텍스트/링크로 쓸 때 전용. 아이보리 대비 7.50:1." },
    "ochre": { "value": "#D9A441", "type": "color", "description": "아이콘·소형 포인트. Dark 텍스트만 Large 사이즈에 사용." },
    "ochreDark": { "value": "#A9781F", "type": "color", "description": "큰 텍스트/배너 전용. White 텍스트 3.89:1 Large만 PASS." },
    "error": { "value": "#A3392A", "type": "color", "description": "폼 에러 텍스트/배지." },
    "success": { "value": "#2C6B3F", "type": "color", "description": "완료·확인 상태." },
    "ink": { "value": "#2E241C", "type": "color", "description": "다크 섹션(푸터 등) 배경." },
    "inkText": { "value": "#FBF7F1", "type": "color", "description": "다크 섹션 위 텍스트. 14.2:1 PASS." },
    "inkSubtext": { "value": "#B9AA9A", "type": "color", "description": "다크 섹션 보조 텍스트. 6.70:1 PASS." },
    "disabledBg": { "value": "#EDE0D3", "type": "color", "description": "비활성 배경." },
    "disabledText": { "value": "#7A6F5E", "type": "color", "description": "비활성 텍스트. WCAG 비활성 컨트롤 예외 적용." },
    "onClay": { "value": "#FFFFFF", "type": "color", "description": "클레이 배경 위 텍스트." },
    "onSage": { "value": "#FFFFFF", "type": "color", "description": "세이지 배경 위 텍스트." }
  },
  "typography": {
    "hero": { "fontFamily": "Pretendard Variable, Pretendard, -apple-system, sans-serif", "fontSize": "44px", "mobileFontSize": "30px", "fontWeight": 800, "lineHeight": 1.4, "letterSpacing": -0.01 },
    "section": { "fontFamily": "Pretendard Variable, Pretendard, -apple-system, sans-serif", "fontSize": "30px", "mobileFontSize": "24px", "fontWeight": 800, "lineHeight": 1.35, "letterSpacing": -0.01 },
    "card": { "fontFamily": "Pretendard Variable, Pretendard, -apple-system, sans-serif", "fontSize": "21px", "mobileFontSize": "19px", "fontWeight": 700, "lineHeight": 1.4, "letterSpacing": 0 },
    "body": { "fontFamily": "Pretendard Variable, Pretendard, -apple-system, sans-serif", "fontSize": "16px", "mobileFontSize": "15px", "fontWeight": 500, "lineHeight": 1.68, "letterSpacing": 0 },
    "label": { "fontFamily": "Pretendard Variable, Pretendard, -apple-system, sans-serif", "fontSize": "13px", "mobileFontSize": "12px", "fontWeight": 700, "lineHeight": 1.3, "letterSpacing": 0 },
    "caption": { "fontFamily": "Pretendard Variable, Pretendard, -apple-system, sans-serif", "fontSize": "13px", "mobileFontSize": "12px", "fontWeight": 600, "lineHeight": 1.55, "letterSpacing": 0 },
    "metric": { "fontFamily": "Pretendard Variable, Pretendard, -apple-system, sans-serif", "fontSize": "32px", "mobileFontSize": "26px", "fontWeight": 800, "lineHeight": 1.1, "letterSpacing": 0 }
  },
  "radius": {
    "xs": { "value": "8px", "type": "borderRadius" },
    "sm": { "value": "14px", "type": "borderRadius" },
    "md": { "value": "20px", "type": "borderRadius" },
    "lg": { "value": "28px", "type": "borderRadius" },
    "full": { "value": "999px", "type": "borderRadius" }
  },
  "spacing": {
    "xs": { "value": "8px", "type": "spacing" },
    "sm": { "value": "12px", "type": "spacing" },
    "md": { "value": "16px", "type": "spacing" },
    "lg": { "value": "24px", "type": "spacing" },
    "xl": { "value": "36px", "type": "spacing" },
    "xxl": { "value": "56px", "type": "spacing" },
    "section": { "value": "96px", "type": "spacing" }
  },
  "components": {
    "buttonPrimary": {
      "backgroundColor": "{colors.clay}",
      "textColor": "{colors.onClay}",
      "typography": "{typography.label}",
      "radius": "{radius.full}",
      "padding": "14px 26px",
      "height": "52px",
      "states": {
        "hover": { "backgroundColor": "{colors.clayHover}" },
        "focus": { "outline": "2px solid {colors.clay}", "outlineOffset": "2px" },
        "disabled": { "backgroundColor": "{colors.disabledBg}", "textColor": "{colors.disabledText}", "cursor": "not-allowed" }
      }
    },
    "buttonSecondary": {
      "backgroundColor": "transparent",
      "textColor": "{colors.clay}",
      "borderColor": "{colors.clayLight}",
      "typography": "{typography.label}",
      "radius": "{radius.full}",
      "padding": "14px 26px",
      "height": "52px",
      "states": {
        "hover": { "backgroundColor": "{colors.surfaceAlt}" },
        "focus": { "outline": "2px solid {colors.clay}", "outlineOffset": "2px" },
        "disabled": { "backgroundColor": "{colors.disabledBg}", "textColor": "{colors.disabledText}", "cursor": "not-allowed" }
      }
    },
    "buttonTertiary": {
      "backgroundColor": "{colors.sage}",
      "textColor": "{colors.onSage}",
      "typography": "{typography.label}",
      "radius": "{radius.full}",
      "padding": "14px 26px",
      "height": "52px"
    },
    "badgeClay": { "backgroundColor": "#F3E1D4", "textColor": "{colors.clay}", "typography": "{typography.label}", "radius": "{radius.full}", "padding": "7px 14px" },
    "badgeSage": { "backgroundColor": "#E3ECE1", "textColor": "{colors.sageText}", "typography": "{typography.label}", "radius": "{radius.full}", "padding": "7px 14px" },
    "badgeOchre": { "backgroundColor": "#F7E7C4", "textColor": "{colors.ochreDark}", "typography": "{typography.label}", "radius": "{radius.full}", "padding": "7px 14px" },
    "card": {
      "backgroundColor": "{colors.surface}",
      "borderColor": "{colors.border}",
      "radius": "{radius.md}",
      "padding": "16px",
      "titleTypography": "{typography.card}",
      "bodyTypography": "{typography.body}",
      "productThumbnailAspect": "4 / 3",
      "blogThumbnailAspect": "16 / 9"
    },
    "formField": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "borderColor": "{colors.border}",
      "typography": "{typography.body}",
      "radius": "{radius.sm}",
      "height": "52px",
      "padding": "14px 18px",
      "states": {
        "focus": { "borderColor": "{colors.clay}", "outline": "2px solid {colors.clay}", "outlineOffset": "2px" },
        "error": { "borderColor": "{colors.error}", "helpTextColor": "{colors.error}" },
        "success": { "helpTextColor": "{colors.success}" },
        "disabled": { "backgroundColor": "{colors.disabledBg}", "textColor": "{colors.disabledText}", "cursor": "not-allowed" }
      }
    },
    "ctaBannerSage": { "backgroundColor": "{colors.sage}", "textColor": "{colors.onSage}", "radius": "{radius.lg}", "padding": "32px" },
    "ctaBannerClay": { "backgroundColor": "{colors.clay}", "textColor": "{colors.onClay}", "radius": "{radius.lg}", "padding": "32px" },
    "darkSection": { "backgroundColor": "{colors.ink}", "textColor": "{colors.inkText}", "subtextColor": "{colors.inkSubtext}" },
    "errorMessage": { "textColor": "{colors.error}", "typography": "{typography.caption}" },
    "successMessage": { "textColor": "{colors.success}", "typography": "{typography.caption}" }
  },
  "media": {
    "heroImage": {
      "aspectRatio": "16 / 10",
      "mobileAspectRatio": "4 / 5",
      "minWidth": "1600px",
      "minHeight": "1000px",
      "focalPoint": "상담/실측 중인 사람이 드러나는 장면 우선, 그 다음 door-or-partition plus surrounding interior",
      "safeTextArea": "left or right 42% on desktop, top 35% on mobile"
    },
    "caseCardImage": {
      "aspectRatio": "4 / 3",
      "minWidth": "1200px",
      "minHeight": "900px",
      "focalPoint": "finished door or partition with floor and wall context"
    },
    "blogThumbnail": {
      "aspectRatio": "16 / 9",
      "minWidth": "1280px",
      "minHeight": "720px",
      "focalPoint": "product, before-after difference, or clear home mood",
      "safeTextArea": "outer 12% padding kept free from key product details"
    }
  }
}
