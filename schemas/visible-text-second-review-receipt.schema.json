{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/visible-text-second-review-receipt.schema.json",
  "title": "Munjanggun Visible Text Independent Second Review Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "method", "sourceObjectSha256", "observedText", "region", "pixelEvidenceSha256", "observationDigest", "reviewerPrincipalId", "reviewedAt", "signature"],
  "properties": {
    "schema": { "const": "munjanggun.visibleTextSecondReview.v1" },
    "version": { "const": "1.0" },
    "status": { "const": "confirmed_visible" },
    "method": { "const": "independent_crop_review" },
    "sourceObjectSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observedText": { "type": "string", "minLength": 1 },
    "region": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height", "unit"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "unit": { "const": "normalized" }
      }
    },
    "pixelEvidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewerPrincipalId": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "valueBase64"],
      "properties": {
        "algorithm": { "const": "Ed25519" }, "keyId": { "type": "string", "minLength": 1 },
        "valueBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    }
  }
}
