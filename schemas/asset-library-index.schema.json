{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-library-index.schema.json",
  "title": "Munjanggun Asset Library Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "libraryId", "updatedAt", "pointers"],
  "properties": {
    "schema": { "const": "munjanggun.assetLibraryIndex.v1" },
    "version": { "const": "1.0" },
    "libraryId": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "pointers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pointerId", "pointerPath", "pointerSha256"],
        "properties": {
          "pointerId": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "pointerPath": { "type": "string", "minLength": 1 },
          "pointerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
