{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-url-review.schema.json",
  "title": "Munjanggun Intake URL Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "intakeId", "checkedAt", "method", "recordCount", "entries"],
  "properties": {
    "schema": { "const": "munjanggun.assetUrlReview.v1" },
    "version": { "const": "1.0" },
    "intakeId": { "type": "string", "pattern": "^INTAKE-[0-9]{8}-[0-9]{2}$" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "method": { "enum": ["signed_in_browser_read_only", "public_browser_read_only"] },
    "recordCount": { "type": "integer", "minimum": 0 },
    "confirmationReceiptRef": { "type": "string", "minLength": 1 },
    "confirmationReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRelativePath", "url", "productId", "accessStatus", "observedTitle",
          "productConnectionStatus", "claimReviewStatus", "notes"
        ],
        "properties": {
          "sourceRelativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
          },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "productId": { "type": "string", "pattern": "^[0-9]+$" },
          "accessStatus": { "enum": ["accessible", "redirected", "blocked", "unreachable"] },
          "observedTitle": { "type": "string", "minLength": 1 },
          "productConnectionStatus": { "enum": ["matched", "needs_review", "mismatch"] },
          "claimReviewStatus": { "enum": ["not_reviewed", "needs_confirmation", "verified"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
