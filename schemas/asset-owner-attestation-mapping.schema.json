{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-owner-attestation-mapping.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "intakeId", "generatedAt", "generatedBy", "mappingMethod", "catalogRef", "catalogSha256", "ownerAttestationRef", "ownerAttestationSha256", "assetCount", "sourcePathCount", "entries"],
  "properties": {
    "schema": { "const": "munjanggun.assetOwnerAttestationMapping.v1" },
    "version": { "const": "1.0" },
    "intakeId": { "type": "string", "pattern": "^INTAKE-[0-9]{8}-[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedBy": { "const": "codex_worker_catalog_expansion" },
    "mappingMethod": { "const": "exact_catalog_sha_membership" },
    "catalogRef": { "$ref": "#/$defs/relativePath" },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "ownerAttestationRef": { "$ref": "#/$defs/relativePath" },
    "ownerAttestationSha256": { "$ref": "#/$defs/sha256" },
    "assetCount": { "type": "integer", "minimum": 1 },
    "sourcePathCount": { "type": "integer", "minimum": 1 },
    "entries": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "contentId", "evidenceId", "artifactRef", "sourceGroupIds", "sourcePathCount"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "contentId": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string", "pattern": "^RIGHTS-EV-OWNER-ORDER-[A-F0-9]{16}$" },
        "artifactRef": { "$ref": "#/$defs/relativePath" },
        "sourceGroupIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sourcePathCount": { "type": "integer", "minimum": 1 }
      }
    } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }
  }
}
