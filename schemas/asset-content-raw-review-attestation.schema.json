{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-content-raw-review-attestation.schema.json",
  "title": "Munjanggun Raw Review Exact-bytes Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "authorityStatus",
    "attestationStatus",
    "rawTranscriptPath",
    "rawTranscriptSha256",
    "rawTranscriptByteSize",
    "transcriptId",
    "reviewRole",
    "reviewerPrincipalId",
    "queueRef",
    "queueSha256",
    "entrySetSha256",
    "queueIndices",
    "attestedAt",
    "signature"
  ],
  "properties": {
    "schema": { "const": "munjanggun.assetContentReviewRawBatchAttestation.v1" },
    "version": { "const": "1.0" },
    "authorityStatus": { "const": "non_authority" },
    "attestationStatus": { "const": "reviewer_attested_exact_bytes" },
    "rawTranscriptPath": { "type": "string", "minLength": 1 },
    "rawTranscriptSha256": { "$ref": "#/$defs/sha256" },
    "rawTranscriptByteSize": { "type": "integer", "minimum": 1 },
    "transcriptId": { "type": "string", "minLength": 1 },
    "reviewRole": { "enum": ["fresh_primary", "fresh_secondary"] },
    "reviewerPrincipalId": { "type": "string", "minLength": 1 },
    "queueRef": { "type": "string", "minLength": 1 },
    "queueSha256": { "$ref": "#/$defs/sha256" },
    "entrySetSha256": { "$ref": "#/$defs/sha256" },
    "queueIndices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "attestedAt": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "valueBase64"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "minLength": 1 },
        "valueBase64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
