{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-use-evidence-receipt.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "intakeId", "sealedAt", "catalogSha256", "registryRef", "registrySha256", "fileCount", "treeHash", "entries", "signature"],
  "properties": {
    "schema": { "const": "munjanggun.assetUseEvidenceReceipt.v1" },
    "version": { "const": "1.0" },
    "intakeId": { "type": "string", "pattern": "^INTAKE-[0-9]{8}-[0-9]{2}$" },
    "sealedAt": { "type": "string", "format": "date-time" },
    "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "registryRef": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "registrySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileCount": { "type": "integer", "minimum": 0 },
    "treeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": { "$ref": "#/$defs/signature" },
    "entries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "relativePath", "byteSize", "sha256"], "properties": {
      "evidenceId": { "type": "string", "pattern": "^(RIGHTS|CLAIM)-EV-[A-Z0-9-]+$" },
      "relativePath": { "type": "string", "minLength": 1 },
      "byteSize": { "type": "integer", "minimum": 1 },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    } } }
  },
  "$defs": { "signature": { "anyOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "valueBase64"], "properties": {
    "algorithm": { "const": "Ed25519" }, "keyId": { "type": "string", "minLength": 1 }, "valueBase64": { "type": "string", "minLength": 40 }
  } } ] } }
}
