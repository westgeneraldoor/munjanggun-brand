{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/product-detail-asset-manifest.schema.json",
  "title": "Munjanggun Product Detail Asset Manifest",
  "type": "object",
  "required": [
    "schema",
    "version",
    "generatedAt",
    "updatedAt",
    "productId",
    "product",
    "slug",
    "sourceId",
    "proofId",
    "sourceFolder",
    "sourceType",
    "sourcePolicy",
    "consumerRule",
    "assetCount",
    "roleCounts",
    "collectionCounts",
    "claimRiskCounts",
    "privacyStatusCounts",
    "duplicateGroupCount",
    "assets"
  ],
  "properties": {
    "schema": { "const": "munjanggun.productDetailAssets.v1" },
    "version": { "type": ["string", "number"] },
    "generatedAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "productId": { "type": "string" },
    "product": { "type": "string" },
    "slug": { "type": "string" },
    "sourceId": { "type": "string" },
    "proofId": { "type": "string" },
    "sourceFolder": { "type": "string" },
    "sourceType": { "type": "string" },
    "sourcePolicy": { "type": "string" },
    "consumerRule": { "type": "string" },
    "assetCount": { "type": "integer", "minimum": 0 },
    "roleCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "collectionCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "claimRiskCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "privacyStatusCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "duplicateGroupCount": { "type": "integer", "minimum": 0 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "productId",
          "sourceId",
          "proofId",
          "product",
          "relativePath",
          "repositoryPath",
          "fileName",
          "extension",
          "sequence",
          "folderRole",
          "collection",
          "byteSize",
          "width",
          "height",
          "gifFrameCount",
          "sha256",
          "duplicateGroup",
          "usageStatus",
          "privacyStatus",
          "claimRisk",
          "externalPublish",
          "notes"
        ],
        "properties": {
          "assetId": { "type": "string" },
          "productId": { "type": "string" },
          "sourceId": { "type": "string" },
          "proofId": { "type": "string" },
          "product": { "type": "string" },
          "relativePath": { "type": "string" },
          "repositoryPath": { "type": "string" },
          "fileName": { "type": "string" },
          "extension": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 0 },
          "folderRole": { "type": "string" },
          "collection": { "type": ["string", "null"] },
          "byteSize": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "gifFrameCount": { "type": ["integer", "null"], "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "duplicateGroup": { "type": ["string", "null"] },
          "usageStatus": { "enum": ["candidate", "needs_confirmation", "vetted", "publishable", "restricted", "expired", "retired"] },
          "privacyStatus": { "enum": ["official_reviewed", "not_verified", "checked", "restricted"] },
          "claimRisk": { "enum": ["low", "medium", "high"] },
          "externalPublish": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
