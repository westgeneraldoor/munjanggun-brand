{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-use-evidence-artifact.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "evidenceId", "kind", "decisionRef", "decisionStatus", "subjectSha256", "contentId", "scopes", "channels", "validFrom", "validUntil", "assertedBy", "assertedAt", "sourceEvidenceRefs"],
  "properties": {
    "schema": { "const": "munjanggun.assetUseEvidenceArtifact.v1" },
    "version": { "const": "1.0" },
    "evidenceId": { "type": "string", "pattern": "^(RIGHTS|CLAIM)-EV-[A-Z0-9-]+$" },
    "kind": { "enum": ["rights", "claim"] },
    "decisionRef": { "type": "string", "minLength": 1 },
    "decisionStatus": { "const": "verified" },
    "subjectSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contentId": { "type": "string", "minLength": 1 },
    "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["internal_preservation", "public_git_storage", "external_reuse"] } },
    "channels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["blog", "sns", "detail_page", "public_git"] } },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": ["string", "null"], "format": "date-time" },
    "assertedBy": { "type": "string", "minLength": 1 },
    "assertedAt": { "type": "string", "format": "date-time" },
    "sourceEvidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
