{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-owner-decisions.schema.json",
  "title": "Munjanggun Asset Owner Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "intakeId", "generatedAt", "catalogSha256", "inheritancePolicy", "rightsDecisions", "assetDecisionCount", "assetDecisions", "escalationDecisionCount", "escalationDecisions"],
  "properties": {
    "schema": { "const": "munjanggun.assetOwnerDecisions.v1" },
    "version": { "const": "1.0" },
    "intakeId": { "type": "string", "pattern": "^INTAKE-[0-9]{8}-[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inheritancePolicy": { "const": "global_answers_do_not_propagate_to_asset_decisions" },
    "rightsDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internalPreservation", "publicGitStorage", "externalReuse", "specialAssetRestrictions"],
      "properties": {
        "internalPreservation": { "$ref": "#/$defs/decision" },
        "publicGitStorage": { "$ref": "#/$defs/decision" },
        "externalReuse": { "$ref": "#/$defs/decision" },
        "specialAssetRestrictions": { "$ref": "#/$defs/decision" }
      }
    },
    "assetDecisionCount": { "type": "integer", "minimum": 0 },
    "assetDecisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assetDecision" }
    },
    "escalationDecisionCount": { "type": "integer", "minimum": 0 },
    "escalationDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "contentId", "humanReviewDecision", "claimDecision", "privacyDecision", "rightsDecision", "evidenceRefs", "notes"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "contentId": { "type": "string", "minLength": 1 },
          "humanReviewDecision": { "enum": ["pending", "approved", "restricted"] },
          "claimDecision": { "enum": ["pending", "verified", "not_applicable", "restricted"] },
          "privacyDecision": { "enum": ["pending", "cleared", "restricted", "needs_redaction"] },
          "rightsDecision": { "enum": ["pending", "verified", "restricted"] },
          "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceRefs", "notes"],
      "properties": {
        "status": { "enum": ["pending", "approved", "restricted"] },
        "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string" }
      }
    },
    "assetDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "contentId", "needsEscalation", "humanReviewDecision", "claimDecision", "privacyDecision", "rightsDecision", "evidenceRefs", "notes"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contentId": { "type": "string", "minLength": 1 },
        "needsEscalation": { "type": "boolean" },
        "humanReviewDecision": { "enum": ["pending", "approved", "restricted"] },
        "claimDecision": { "enum": ["pending", "verified", "not_applicable", "restricted"] },
        "privacyDecision": { "enum": ["pending", "cleared", "restricted", "needs_redaction"] },
        "rightsDecision": { "enum": ["pending", "verified", "restricted"] },
        "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string" }
      }
    }
  }
}
