{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-content-catalog.schema.json",
  "title": "Munjanggun Asset Content Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "intakeId", "generatedAt", "binaryGroupCount", "entries"],
  "properties": {
    "schema": { "const": "munjanggun.assetContentCatalog.v2" },
    "version": { "const": "2.0" },
    "intakeId": { "type": "string", "pattern": "^INTAKE-[0-9]{8}-[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "binaryGroupCount": { "type": "integer", "minimum": 0 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "reviewSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedBinaryGroups", "needsEscalation", "sourcePathLinks",
        "uniqueGifFrames", "uniqueGifDurationMs", "linkedGifFrames", "linkedGifDurationMs"
      ],
      "properties": {
        "reviewedBinaryGroups": { "type": "integer", "minimum": 0 },
        "needsEscalation": { "type": "integer", "minimum": 0 },
        "sourcePathLinks": { "type": "integer", "minimum": 0 },
        "uniqueGifFrames": { "type": "integer", "minimum": 0 },
        "uniqueGifDurationMs": { "type": "integer", "minimum": 0 },
        "linkedGifFrames": { "type": "integer", "minimum": 0 },
        "linkedGifDurationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "reviewEvidenceReceiptRef": { "type": "string", "minLength": 1 },
    "reviewEvidenceReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binaryGroupId", "objectRef", "sha256", "byteSize", "mediaType", "sourcePathCount", "sourceRefs",
          "contentId", "visualGroupId", "comparisonMethod", "humanReviewStatus", "semanticSummary",
          "ocrText", "gifReviewStatus", "claimSignals", "privacySignals", "rightsSignals",
          "rightsStatus", "rightsScope", "rightsEvidenceRef", "privacyStatus", "claimReviewStatus", "claimEvidenceRef", "publishStatus", "publicRepoEligibility"
        ],
        "properties": {
          "binaryGroupId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "objectRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "byteSize": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string", "minLength": 1 },
          "sourcePathCount": { "type": "integer", "minimum": 1 },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "sourceRelativePath"],
              "properties": {
                "sourceId": { "type": "string", "minLength": 1 },
                "sourceRelativePath": { "type": "string", "minLength": 1 }
              }
            }
          },
          "contentId": { "type": "string", "minLength": 1 },
          "visualGroupId": { "type": ["string", "null"] },
          "semanticGroupId": { "type": ["string", "null"] },
          "visualGroupDecision": { "enum": ["not_reviewed", "accepted_candidate", "split_after_audit"] },
          "comparisonMethod": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "humanReviewStatus": { "enum": ["not_reviewed", "in_review", "reviewed", "needs_escalation"] },
          "semanticSummary": { "type": "string" },
          "ocrText": { "type": "string" },
          "gifReviewStatus": { "enum": ["not_applicable", "not_reviewed", "in_review", "reviewed"] },
          "claimSignals": { "type": "array", "items": { "type": "string" } },
          "privacySignals": { "type": "array", "items": { "type": "string" } },
          "rightsSignals": { "type": "array", "items": { "type": "string" } },
          "rightsStatus": { "enum": ["not_reviewed", "pending", "verified", "restricted", "expired"] },
          "rightsScope": { "type": "array", "uniqueItems": true, "items": { "enum": ["internal_preservation", "private_codex_source", "public_git_storage", "external_reuse"] } },
          "rightsEvidenceRef": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^RIGHTS-EV-[A-Z0-9-]+$" } },
          "privacyStatus": { "enum": ["not_reviewed", "cleared", "restricted", "needs_redaction"] },
          "claimReviewStatus": { "enum": ["not_reviewed", "not_applicable", "needs_confirmation", "verified", "expired", "restricted"] },
          "claimEvidenceRef": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CLAIM-EV-[A-Z0-9-]+$" } },
          "publishStatus": { "enum": ["blocked", "needs_confirmation", "eligible", "published", "withdrawn"] },
          "publicRepoEligibility": { "enum": ["not_reviewed", "prohibited", "eligible"] },
          "reviewEvidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "reviewNotes": { "type": "string" },
          "gifMetadata": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["frameCount", "durationMs", "loopCount", "loopBehavior"],
                "properties": {
                  "frameCount": { "type": "integer", "minimum": 1 },
                  "durationMs": { "type": "integer", "minimum": 0 },
                  "loopCount": { "type": "integer", "minimum": 0 },
                  "loopBehavior": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
