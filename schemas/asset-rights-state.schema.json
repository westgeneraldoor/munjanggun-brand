{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-rights-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "intakeId", "generatedAt", "catalogSha256", "ownerAttestation", "workerMapping", "ownerDecisionLedger", "effectiveAccess", "remainingGates"],
  "properties": {
    "schema": { "const": "munjanggun.assetRightsState.v1" },
    "version": { "const": "1.0" },
    "intakeId": { "type": "string", "pattern": "^INTAKE-[0-9]{8}-[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "ownerAttestation": { "$ref": "#/$defs/refState" },
    "workerMapping": { "$ref": "#/$defs/refState" },
    "ownerDecisionLedger": { "$ref": "#/$defs/refState" },
    "effectiveAccess": {
      "type": "object", "additionalProperties": false,
      "required": ["privatePreservation", "privateCodexSource", "blogSnsRights", "blogSnsPublication", "publicGit"],
      "properties": {
        "privatePreservation": { "const": "allowed_by_recorded_owner_order" },
        "privateCodexSource": { "const": "allowed_by_recorded_owner_order" },
        "blogSnsRights": { "const": "owner_approved_unsealed" },
        "blogSnsPublication": { "const": "blocked_pending_signature_claim_privacy_and_human_review" },
        "publicGit": { "const": "blocked_owner_pending" }
      }
    },
    "remainingGates": {
      "type": "object", "additionalProperties": false,
      "required": ["trustedOwnerSignature", "claimAssetCount", "privacyAssetCount", "escalationAssetCount"],
      "properties": {
        "trustedOwnerSignature": { "const": "missing" },
        "claimAssetCount": { "type": "integer", "minimum": 0 },
        "privacyAssetCount": { "type": "integer", "minimum": 0 },
        "escalationAssetCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "refState": { "type": "object", "additionalProperties": false, "required": ["ref", "sha256", "status"], "properties": {
      "ref": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "status": { "type": "string", "minLength": 1 }
    } }
  }
}
