{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-library-pointer.schema.json",
  "title": "Munjanggun Private Asset Library Pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "libraryId", "updatedAt", "current"],
  "properties": {
    "schema": { "const": "munjanggun.assetLibraryPointer.v1" },
    "version": { "const": "1.0" },
    "libraryId": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogPath", "catalogSha256", "objectRoot",
        "rightsBundleRoot", "rightsStateRef", "rightsStateSha256", "anchorPath", "anchorSha256"
      ],
      "properties": {
        "catalogPath": { "type": "string", "minLength": 1 },
        "catalogSha256": { "$ref": "#/$defs/sha256" },
        "objectRoot": { "type": "string", "minLength": 1 },
        "rightsBundleRoot": { "type": "string", "minLength": 1 },
        "rightsStateRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
        },
        "rightsStateSha256": { "$ref": "#/$defs/sha256" },
        "anchorPath": { "type": "string", "minLength": 1 },
        "anchorSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
