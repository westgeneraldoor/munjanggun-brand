{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westgeneraldoor/munjanggun-brand/schemas/asset-content-revalidation-receipt.schema.json",
  "title": "Munjanggun Content Revalidation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "intakeId", "sealedAt", "baseCatalogSha256", "overlaySha256",
    "entryCount", "verifiedCount", "needsEscalationCount", "staticCount", "gifCount",
    "fullLoopGifCount", "reviewFiles", "treeHash"
  ],
  "properties": {
    "schema": { "const": "munjanggun.assetContentRevalidationReceipt.v1" },
    "version": { "const": "1.0" },
    "intakeId": { "type": "string", "pattern": "^INTAKE-[0-9]{8}-[0-9]{2}$" },
    "sealedAt": { "type": "string", "format": "date-time" },
    "baseCatalogSha256": { "$ref": "#/$defs/sha256" },
    "overlaySha256": { "$ref": "#/$defs/sha256" },
    "entryCount": { "type": "integer", "minimum": 1 },
    "verifiedCount": { "type": "integer", "minimum": 0 },
    "needsEscalationCount": { "type": "integer", "minimum": 0 },
    "staticCount": { "type": "integer", "minimum": 0 },
    "gifCount": { "type": "integer", "minimum": 0 },
    "fullLoopGifCount": { "type": "integer", "minimum": 0 },
    "reviewFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "entryCount"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "entryCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "treeHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
